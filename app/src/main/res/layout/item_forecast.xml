<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardForecast"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- O tahmindeki hava durumuna uygun arka plan görseli (sunny, rainy, snowy, moony vb.) -->
        <ImageView
            android:id="@+id/imageViewCardBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/partlycloudy" />

        <!-- Şeffaf karartma katmanı (#55000000) - yazının okunmasını sağlar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#55000000" />

        <!-- Orijinal kart içeriği -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp">

            <!-- Sol taraf - İkon ve Sıcaklık -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageViewIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/icon_sunny"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/textViewTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25°C"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#f5f5f5"/>
            </LinearLayout>

            <!-- Sağ taraf - Detay Bilgileri -->
            <LinearLayout
                android:id="@+id/layoutDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="10dp">

                <!-- Tarih -->
                <TextView
                    android:id="@+id/textViewDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01 Ocak 2024 - Pazartesi"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#f5f5f5"
                    android:layout_marginBottom="5dp"/>

                <!-- Açıklama -->
                <TextView
                    android:id="@+id/textViewDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parçalı bulutlu"
                    android:textSize="13sp"
                    android:textColor="#f5f5f5"
                    android:layout_marginBottom="8dp"/>

                <!-- Min/Max Sıcaklık -->
                <TextView
                    android:id="@+id/textViewTempRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min: 18°C / Max: 28°C"
                    android:textSize="12sp"
                    android:textColor="#f5f5f5"
                    android:layout_marginBottom="8dp"/>

                <!-- Nem ve Rüzgar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textViewHumidity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nem: --%"
                        android:textSize="11sp"
                        android:textColor="#f5f5f5"/>

                    <TextView
                        android:id="@+id/textViewWind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rüzgar: -- km/h"
                        android:textSize="11sp"
                        android:textColor="#f5f5f5"/>
                </LinearLayout>

                <!-- Yağış ve olasılık-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textViewRain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 mm"
                        android:textSize="11sp"
                        android:textColor="#f5f5f5"/>

                    <TextView
                        android:id="@+id/textViewRainProbability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--%"
                        android:textSize="11sp"
                        android:textColor="#f5f5f5"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>